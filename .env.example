# .env.example — Template for machine-local configuration
# Copy this file to .env and fill in your own values.
# NEVER commit .env to Git.

# ================================================================
# Dataset paths — set for each laptop separately
# ================================================================

# Root of the extracted Ceramic-Defect archive (folder containing 'original image', 'image', 'lables').
#
# Laptop 1 (Windows, Drive E):
#   DATASET_ROOT=E:/MTech[CSE] Nirma_University/S3/Major Project/Defect Dataset Augmentation using Generative Adversarial Networks (GAN)/Dateset/Ceramic-defect/data/data
#
# Laptop 2 (different path, e.g. Drive D):
#   DATASET_ROOT=D:/Datasets/Ceramic-defect/data/data
#
# Google Colab (MyDrive path confirmed by user):
#   DATASET_ROOT=/content/drive/MyDrive/Ceramic-defect/data/data
#
DATASET_ROOT=

# Path to Phase 1 frozen split manifests directory (containing train.csv, val.csv, test.csv, split_manifest.json)
# Default if unset: <project_root>/outputs/splits/phase1
SPLIT_MANIFEST_DIR=

# Google Drive Root (used in Colab to store checkpoints and experiment logs persistently)
# Colab default: /content/drive/MyDrive
GOOGLE_DRIVE_ROOT=

# Persistent checkpoint storage directory
# Local default: <project_root>/outputs/checkpoints
# Colab default: /content/drive/MyDrive/MajorProject_Outputs/checkpoints
CHECKPOINT_DIR=

# Experiment output directory (logs, metrics, evaluation results)
# Local default: <project_root>/outputs
# Colab default: /content/drive/MyDrive/MajorProject_Outputs
EXPERIMENT_OUTPUT_DIR=

# ================================================================
# Experiment configuration
# ================================================================

# Random seed for reproducibility across all runs
RANDOM_SEED=42

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
